+
+/* Arithmetic form of the ghost1/ghost2 blend for RGB565 targets. The two
+   128 KB tables miss the L1 cache on nearly every pixel of a scaled or
+   translucent sprite on a Cortex-A9; the same result computed in registers
+   is several times faster. Used when the tables are alpha tables (per
+   component: ((c * f) >> 8), summed) or the 50 % colorghost table; a
+   per-graph blend_table still goes through the tables. */
+static int ghost_arith = 0 ;
+static uint32_t ghost_f1 = 128, ghost_f2 = 128 ;
+
+static void ghost_set_factors( int f1, int f2 )
+{
+    ghost_f1 = f1 ; ghost_f2 = f2 ;
+    ghost_arith = ( sys_pixel_format->Rmask == 0xF800 &&
+                    sys_pixel_format->Gmask == 0x07E0 &&
+                    sys_pixel_format->Bmask == 0x001F ) ;
+}
+
+static inline uint16_t ghost_blend16( uint32_t t, uint32_t d )
+{
+    /* r and b share one word (r at bit 16, b at bit 0): with f <= 256 the
+       products are 13 bits wide and cannot overlap */
+    uint32_t trb = (( t & 0xF800 ) << 5 ) | ( t & 0x1F ) ;
+    uint32_t drb = (( d & 0xF800 ) << 5 ) | ( d & 0x1F ) ;
+    uint32_t rb  = ((( trb * ghost_f1 ) >> 8 ) & 0x001F001F ) + ((( drb * ghost_f2 ) >> 8 ) & 0x001F001F ) ;
+    uint32_t g   = (((( t >> 5 ) & 0x3F ) * ghost_f1 ) >> 8 ) + (((( d >> 5 ) & 0x3F ) * ghost_f2 ) >> 8 ) ;
+    return ( uint16_t )((( rb >> 5 ) & 0xF800 ) | ( g << 5 ) | ( rb & 0x1F )) ;
+}
 uint8_t   * ghost8;
 
 uint32_t * pcolorequiv = NULL ;
