diff --git a/modules/libgrbase/g_conversion.c b/modules/libgrbase/g_conversion.c
index 81eafa4..f568dfb 100644
--- a/modules/libgrbase/g_conversion.c
+++ b/modules/libgrbase/g_conversion.c
@@ -457,6 +457,18 @@ uint16_t * gr_alpha16( int alpha )
     return alpha16[ alpha ];
 }
 
+/* The blend factor (0..256) that gr_alpha16( alpha ) applies to each colour
+   component, so a blitter can do the same blend arithmetically. */
+int gr_alpha16_factor( int alpha )
+{
+    int inc, factor;
+    if ( !alpha16_tables_ok ) init_alpha16_tables( GLODWORD( libgrbase, ALPHA_STEPS ) );
+    inc = 256 / alpha16_tables_ok;
+    factor = ( alpha / inc ) * inc + inc / 2;
+    if ( factor > 255 ) factor = 256;
+    return factor;
+}
+
