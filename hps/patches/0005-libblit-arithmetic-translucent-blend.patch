+                tex += incs;
+            }
+            scr = ( uint16_t * )( _scr += scr_inc ); tex = ( uint16_t * )( _tex += tex_inc );
+        }
+        return;
+    }
+
     while ( l-- )
     {
         for ( i = pixels; i--; )
@@ -1954,6 +2009,7 @@ void gr_rotated_blit(
         if ( dest->format->depth == 32 ) return ;
         ghost1 = ( uint16_t * ) gr->blend_table ;
         ghost2 = ( uint16_t * )( gr->blend_table + 65536 ) ;
+        ghost_arith = 0 ;
         flags |= B_TRANSLUCENT ;
     }
