+            ptr++;
+            cs += incs, ct += inct;
+        }
+        return;
+    }
+
     while ( pixels-- )
     {
         tex = ( uint16_t * ) orig->data + ( orig->pitch * ( ct >> 16 ) >> 1 ) + ( cs >> 16 );
@@ -1265,6 +1305,21 @@ static void draw_hspan_16to16_translucent( uint16_t *scr, uint16_t * tex, int pi
     int i;
