diff --git a/core/bgdrtm/include/bgdrtm.h b/core/bgdrtm/include/bgdrtm.h
index 8bcc9d4..e16573a 100644
--- a/core/bgdrtm/include/bgdrtm.h
+++ b/core/bgdrtm/include/bgdrtm.h
@@ -42,8 +42,16 @@
 
 /* --------------------------------------------------------------------------- */
 
-extern void * globaldata ;
-extern void * localdata ;
+/* Globals the interpreter loop reads per opcode. In the libretro build
+   (position independent code, linked into one executable) mark them hidden
+   so the compiler addresses them pc-relative instead of through the GOT. */
+#if LIBRETRO_CORE && defined(__GNUC__)
+#define BGDRTM_HOT_GLOBAL __attribute__((visibility("hidden")))
+#else
+#define BGDRTM_HOT_GLOBAL
+#endif
+extern BGDRTM_HOT_GLOBAL void * globaldata ;
+extern BGDRTM_HOT_GLOBAL void * localdata ;
 extern int    local_size ;
 extern int  * localstr ;
 extern int    local_strings ;
@@ -59,7 +67,7 @@ extern char *appexefullpath;
 
 extern char *configfile;
 
-extern int debug ;          /* 1 if running in debug mode */
+extern BGDRTM_HOT_GLOBAL int debug ;          /* 1 if running in debug mode */
 
 /* Trace */
 extern int exit_value;
