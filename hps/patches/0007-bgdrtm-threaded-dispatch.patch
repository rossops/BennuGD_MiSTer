+                NEXT;
+
+            case MN_WORD | MN_VARADD: OPLABEL(op_WORD_VARADD)
+            case MN_WORD | MN_VARADD | MN_UNSIGNED: OPLABEL(op_WORD_VARADD_UNSIGNED)
+                *( int16_t * )ptr_from_int( sp[-2] ) += sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARSUB: OPLABEL(op_WORD_VARSUB)
+            case MN_WORD | MN_VARSUB | MN_UNSIGNED: OPLABEL(op_WORD_VARSUB_UNSIGNED)
+                *( int16_t * )ptr_from_int( sp[-2] ) -= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARMUL: OPLABEL(op_WORD_VARMUL)
+            case MN_WORD | MN_VARMUL | MN_UNSIGNED: OPLABEL(op_WORD_VARMUL_UNSIGNED)
+                *( int16_t * )ptr_from_int( sp[-2] ) *= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARDIV: OPLABEL(op_WORD_VARDIV)
+            case MN_WORD | MN_VARDIV | MN_UNSIGNED: OPLABEL(op_WORD_VARDIV_UNSIGNED)
+                if (( int16_t )sp[-1] == 0 ) {
+                    fprintf( stderr, "ERROR: Runtime error in %s(%d) - Division by zero\n", r->proc->name, LOCDWORD( r, PROCESS_ID ) );
+                    exit( 0 );
+                }
+                *( int16_t * )ptr_from_int( sp[-2] ) /= ( int16_t )sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARMOD: OPLABEL(op_WORD_VARMOD)
+            case MN_WORD | MN_VARMOD | MN_UNSIGNED: OPLABEL(op_WORD_VARMOD_UNSIGNED)
+                if (( int16_t )sp[-1] == 0 ) {
+                    fprintf( stderr, "ERROR: Runtime error in %s(%d) - Division by zero\n", r->proc->name, LOCDWORD( r, PROCESS_ID ) );
+                    exit( 0 );
+                }
+                *( int16_t * )ptr_from_int( sp[-2] ) %= ( int16_t )sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VAROR: OPLABEL(op_WORD_VAROR)
+            case MN_WORD | MN_VAROR | MN_UNSIGNED: OPLABEL(op_WORD_VAROR_UNSIGNED)
+                *( int16_t * )ptr_from_int( sp[-2] ) |= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARXOR: OPLABEL(op_WORD_VARXOR)
+            case MN_WORD | MN_VARXOR | MN_UNSIGNED: OPLABEL(op_WORD_VARXOR_UNSIGNED)
+                *( int16_t * )ptr_from_int( sp[-2] ) ^= sp[-1];
