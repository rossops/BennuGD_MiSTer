+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARROL | MN_UNSIGNED: OPLABEL(op_WORD_VARROL_UNSIGNED)
+                *( uint16_t * )ptr_from_int( sp[-2] ) <<= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            /* Direct operations with variables BYTE type */
+
+            case MN_BYTE | MN_LETNP: OPLABEL(op_BYTE_LETNP)
+            case MN_BYTE | MN_LETNP | MN_UNSIGNED: OPLABEL(op_BYTE_LETNP_UNSIGNED)
+                ( *( uint8_t * )ptr_from_int( sp[-2] ) ) = sp[-1];
+                sp -= 2;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_LET: OPLABEL(op_BYTE_LET)
+            case MN_BYTE | MN_LET | MN_UNSIGNED: OPLABEL(op_BYTE_LET_UNSIGNED)
+                ( *( uint8_t * )ptr_from_int( sp[-2] ) ) = sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_INC: OPLABEL(op_BYTE_INC)
+            case MN_BYTE | MN_INC | MN_UNSIGNED: OPLABEL(op_BYTE_INC_UNSIGNED)
+                ( *( uint8_t * )ptr_from_int( sp[-1] ) ) += ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_BYTE | MN_DEC: OPLABEL(op_BYTE_DEC)
+            case MN_BYTE | MN_DEC | MN_UNSIGNED: OPLABEL(op_BYTE_DEC_UNSIGNED)
+                ( *( uint8_t * )ptr_from_int( sp[-1] ) ) -= ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_BYTE | MN_POSTDEC: OPLABEL(op_BYTE_POSTDEC)
+            case MN_BYTE | MN_POSTDEC | MN_UNSIGNED: OPLABEL(op_BYTE_POSTDEC_UNSIGNED)
+                tmp = ptr_from_int(sp[-1]);
+                ( *( uint8_t * )tmp ) -= ptr[1];
+                sp[-1] = *( uint8_t * )tmp + ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_BYTE | MN_POSTINC: OPLABEL(op_BYTE_POSTINC)
+            case MN_BYTE | MN_POSTINC | MN_UNSIGNED: OPLABEL(op_BYTE_POSTINC_UNSIGNED)
+                tmp = ptr_from_int(sp[-1]);
+                *(( uint8_t * )tmp ) += ptr[1];
+                sp[-1] = *( uint8_t * )tmp - ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_BYTE | MN_VARADD: OPLABEL(op_BYTE_VARADD)
+            case MN_BYTE | MN_VARADD | MN_UNSIGNED: OPLABEL(op_BYTE_VARADD_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) += sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARSUB: OPLABEL(op_BYTE_VARSUB)
+            case MN_BYTE | MN_VARSUB | MN_UNSIGNED: OPLABEL(op_BYTE_VARSUB_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) -= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARMUL: OPLABEL(op_BYTE_VARMUL)
+            case MN_BYTE | MN_VARMUL | MN_UNSIGNED: OPLABEL(op_BYTE_VARMUL_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) *= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARDIV: OPLABEL(op_BYTE_VARDIV)
+            case MN_BYTE | MN_VARDIV | MN_UNSIGNED: OPLABEL(op_BYTE_VARDIV_UNSIGNED)
+                if (( uint8_t )sp[-1] == 0 ) {
+                    fprintf( stderr, "ERROR: Runtime error in %s(%d) - Division by zero\n", r->proc->name, LOCDWORD( r, PROCESS_ID ) );
+                    exit( 0 );
+                }
+                *( uint8_t * )ptr_from_int( sp[-2] ) /= ( uint8_t )sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARMOD: OPLABEL(op_BYTE_VARMOD)
+            case MN_BYTE | MN_VARMOD | MN_UNSIGNED: OPLABEL(op_BYTE_VARMOD_UNSIGNED)
+                if (( uint8_t )sp[-1] == 0 ) {
+                    fprintf( stderr, "ERROR: Runtime error in %s(%d) - Division by zero\n", r->proc->name, LOCDWORD( r, PROCESS_ID ) );
+                    exit( 0 );
+                }
+                *( uint8_t * )ptr_from_int( sp[-2] ) %= ( uint8_t )sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VAROR: OPLABEL(op_BYTE_VAROR)
+            case MN_BYTE | MN_VAROR | MN_UNSIGNED: OPLABEL(op_BYTE_VAROR_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) |= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARXOR: OPLABEL(op_BYTE_VARXOR)
+            case MN_BYTE | MN_VARXOR | MN_UNSIGNED: OPLABEL(op_BYTE_VARXOR_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) ^= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARAND: OPLABEL(op_BYTE_VARAND)
+            case MN_BYTE | MN_VARAND | MN_UNSIGNED: OPLABEL(op_BYTE_VARAND_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) &= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARROR: OPLABEL(op_BYTE_VARROR)
+                *( int8_t * )ptr_from_int( sp[-2] ) >>= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARROR | MN_UNSIGNED: OPLABEL(op_BYTE_VARROR_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) >>= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARROL: OPLABEL(op_BYTE_VARROL)
+                *( int8_t * )ptr_from_int( sp[-2] ) <<= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_BYTE | MN_VARROL | MN_UNSIGNED: OPLABEL(op_BYTE_VARROL_UNSIGNED)
+                *( uint8_t * )ptr_from_int( sp[-2] ) <<= sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            /* Direct operations with variables FLOAT type */
+
+            case MN_FLOAT | MN_LETNP: OPLABEL(op_FLOAT_LETNP)
+                ( *( float * )ptr_from_int( sp[-2] ) ) = *( float * ) & sp[-1];
+                sp -= 2;
+                ptr++;
+                NEXT;
+
+            case MN_FLOAT | MN_LET : OPLABEL(op_FLOAT_LET)
+                ( *( float * )ptr_from_int( sp[-2] ) ) = *( float * ) & sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_FLOAT | MN_INC: OPLABEL(op_FLOAT_INC)
+                ( *( float * )ptr_from_int( sp[-1] ) ) += ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_FLOAT | MN_DEC: OPLABEL(op_FLOAT_DEC)
+                ( *( float * )ptr_from_int( sp[-1] ) ) -= ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_FLOAT | MN_POSTDEC: OPLABEL(op_FLOAT_POSTDEC)
+                tmp = ptr_from_int(sp[-1]);
+                ( *( float * )tmp ) -= ptr[1];
+                sp[-1] = *( uint32_t * )tmp + ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_FLOAT | MN_POSTINC: OPLABEL(op_FLOAT_POSTINC)
+                tmp = ptr_from_int(sp[-1]);
+                *(( float * )tmp ) += ptr[1];
+                sp[-1] = *( uint32_t * )tmp - ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_FLOAT | MN_VARADD: OPLABEL(op_FLOAT_VARADD)
+                *( float * )ptr_from_int( sp[-2] ) += *( float * ) & sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_FLOAT | MN_VARSUB: OPLABEL(op_FLOAT_VARSUB)
+                *( float * )ptr_from_int( sp[-2] ) -= *( float * ) & sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_FLOAT | MN_VARMUL: OPLABEL(op_FLOAT_VARMUL)
+                *( float * )ptr_from_int( sp[-2] ) *= *( float * ) & sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            case MN_FLOAT | MN_VARDIV: OPLABEL(op_FLOAT_VARDIV)
+                *( float * )ptr_from_int( sp[-2] ) /= *( float * ) & sp[-1];
+                sp--;
+                ptr++;
+                NEXT;
+
+            /* Jumps */
+
+            case MN_JUMP: OPLABEL(op_JUMP)
+                ptr = r->code + ptr[1];
+                CONTINUE;
+
+            case MN_JTRUE: OPLABEL(op_JTRUE)
+                sp--;
+                if ( *sp ) {
+                    ptr = r->code + ptr[1];
+                    CONTINUE;
+                }
+                ptr += 2;
+                NEXT;
+
+            case MN_JFALSE: OPLABEL(op_JFALSE)
+                sp--;
+                if ( !*sp ) {
+                    ptr = r->code + ptr[1];
+                    CONTINUE;
+                }
+                ptr += 2;
+                NEXT;
+
+            case MN_JTTRUE: OPLABEL(op_JTTRUE)
+                if ( sp[-1] ) {
+                    ptr = r->code + ptr[1];
+                    CONTINUE;
+                }
+                ptr += 2;
+                NEXT;
+
+            case MN_JTFALSE: OPLABEL(op_JTFALSE)
+                if ( !sp[-1] ) {
+                    ptr = r->code + ptr[1];
+                    CONTINUE;
+                }
+                ptr += 2;
+                NEXT;
+
+            case MN_NCALL: OPLABEL(op_NCALL)
+                *sp++ = ptr - r->code + 2 ; /* Push next address */
+                ptr = r->code + ptr[1] ; /* Call function */
+                r->call_level++;
+                NEXT;
+
+            /* Switch */
+
+            case MN_SWITCH: OPLABEL(op_SWITCH)
+                r->switchval = *--sp;
+                r->cased = 0;
+                ptr++;
+                NEXT;
+
+            case MN_SWITCH | MN_STRING: OPLABEL(op_SWITCH_STRING)
+                if ( r->switchval_string != 0 ) string_discard( r->switchval_string );
+                r->switchval_string = *--sp;
+                r->cased = 0;
+                ptr++;
+                NEXT;
+
+            case MN_CASE: OPLABEL(op_CASE)
+                if ( r->switchval == *--sp ) r->cased = 2;
+                ptr++;
+                NEXT;
+
+            case MN_CASE | MN_STRING: OPLABEL(op_CASE_STRING)
+                if ( string_comp( r->switchval_string, *--sp ) == 0 ) r->cased = 2;
+                string_discard( *sp );
+                string_discard( sp[-1] );
+                ptr++;
+                NEXT;
+
+            case MN_CASE_R: OPLABEL(op_CASE_R)
+                sp -= 2;
+                if ( r->switchval >= sp[0] && r->switchval <= sp[1] ) r->cased = 1;
+                ptr++;
+                NEXT;
+
+            case MN_CASE_R | MN_STRING: OPLABEL(op_CASE_R_STRING)
+                sp -= 2;
+                if ( string_comp( r->switchval_string, sp[0] ) >= 0 &&
+                     string_comp( r->switchval_string, sp[1] ) <= 0 )
+                    r->cased = 1;
+                string_discard( sp[0] );
+                string_discard( sp[1] );
+                ptr++;
+                NEXT;
+
+            case MN_JNOCASE: OPLABEL(op_JNOCASE)
+                if ( r->cased < 1 ) {
+                    ptr = r->code + ptr[1];
+                    CONTINUE;
+                }
+                ptr += 2;
+                NEXT;
+
+            /* Process control */
+
+            case MN_TYPE: OPLABEL(op_TYPE)
+            {
+                PROCDEF * proct = procdef_get( ptr[1] );
+                if ( !proct ) {
+                    fprintf( stderr, "ERROR: Runtime error in %s(%d) - Invalid type\n", r->proc->name, LOCDWORD( r, PROCESS_ID ) );
+                    exit( 0 );
+                }
+                *sp++ = proct->type;
+                ptr += 2;
+                NEXT;
+            }
+
+            case MN_FRAME: OPLABEL(op_FRAME)
+                LOCINT32( r, FRAME_PERCENT ) += sp[-1];
+
+                sp--;
+                r->codeptr = ptr + 1;
+                return_value = LOCDWORD( r, PROCESS_ID );
+
+                if ( !( r->proc->flags & PROC_FUNCTION ) &&
+                        r->called_by && instance_exists( r->called_by ) && ( LOCDWORD( r->called_by, STATUS ) & STATUS_WAITING_MASK ) ) {
+                    /* We're returning and the parent is waiting: wake it up */
+                    if ( r->called_by->stack && ( r->called_by->stack[0] & STACK_RETURN_VALUE ) )
+                        r->called_by->stack_ptr[-1] = return_value;
+
+                    LOCDWORD( r->called_by, STATUS ) &= ~STATUS_WAITING_MASK;
+                    r->called_by = NULL;
+                }
+                goto break_all;
+
+            case MN_END: OPLABEL(op_END)
+                if ( r->call_level > 0 ) {
+                    ptr = r->code + *--sp;
+                    r->call_level--;
+                    CONTINUE;
+                }
+
+                if ( LOCDWORD( r, STATUS ) != STATUS_DEAD ) LOCDWORD( r, STATUS ) = STATUS_KILLED;
+                goto break_all;
+
+            case MN_RETURN: OPLABEL(op_RETURN)
+                if ( r->call_level > 0 ) {
+                    ptr = r->code + *--sp;
+                    r->call_level--;
+                    CONTINUE;
+                }
+
+                if ( LOCDWORD( r, STATUS ) != STATUS_DEAD ) LOCDWORD( r, STATUS ) = STATUS_KILLED;
+                sp--;
+                return_value = *sp;
+                goto break_all;
+
+            /* Handlers */
+
+            case MN_EXITHNDLR: OPLABEL(op_EXITHNDLR)
+                r->exitcode = ptr[1];
+                ptr += 2;
+                NEXT;
+
+            case MN_ERRHNDLR: OPLABEL(op_ERRHNDLR)
+                r->errorcode = ptr[1];
+                ptr += 2;
+                NEXT;
+
+            /* Others */
+
+            case MN_DEBUG: OPLABEL(op_DEBUG)
+                if ( dcb.data.NSourceFiles ) {
+                    if ( debug > 0 ) printf( "\n::: DEBUG from %s(%d)\n", r->proc->name, LOCDWORD( r, PROCESS_ID ) );
+                    trace_sentence = -1;
+                    debugger_show_console = 1;
+                }
+                ptr++;
+                NEXT;
+
+            case MN_SENTENCE: OPLABEL(op_SENTENCE)
+                trace_sentence = ptr[1];
+                trace_instance = r;
+                ptr += 2;
+                if ( debugger_trace || debugger_step ) {
+                    debugger_trace = 0;
+                    debugger_step = 0;
+                    debugger_show_console = 1;
+                }
+                NEXT;
+
+            default: OPLABEL(op_default)
+                fprintf( stderr, "ERROR: Runtime error in %s(%d) - Mnemonic 0x%02X not implemented\n", r->proc->name, LOCDWORD( r, PROCESS_ID ), *ptr );
+                exit( 0 );
+        }
+
+#if THREADED_DISPATCH
+op_slow_next:
+        if ( sp < stack_base ) goto stack_error;
+op_slow_continue:
+        goto loop_head;
+stack_error:
+#endif
+        if ( sp < stack_base ) {
+            fprintf( stderr, "ERROR: Runtime error in %s(%d) - Critical Stack Problem StackBase=%p StackPTR=%p\n", r->proc->name, LOCDWORD( r, PROCESS_ID ), (void *)r->stack, (void *)sp );
+            exit( 0 );
+        }
+
+#ifdef EXIT_ON_EMPTY_STACK
+        if ( sp == r->stack ) {
+            r->codeptr = ptr;
+            if ( LOCDWORD( r, STATUS ) != STATUS_RUNNING && LOCDWORD( r, STATUS ) != STATUS_DEAD ) break;
+        }
+#endif
+    }
+
+    /* *** GENERAL EXIT *** */
+break_all:
+    r->stack_ptr = sp;
+
+    if ( !*ptr || *ptr == MN_RETURN || *ptr == MN_END || LOCDWORD( r, STATUS ) == STATUS_KILLED ) {
+        /* Check for waiting parent */
+        if ( r->called_by && instance_exists( r->called_by ) && ( LOCDWORD( r->called_by, STATUS ) & STATUS_WAITING_MASK ) ) {
+            /* We're returning and the parent is waiting: wake it up */
+            if ( r->called_by->stack && ( r->called_by->stack[0] & STACK_RETURN_VALUE ) )
+                r->called_by->stack_ptr[-1] = return_value;
+
+            LOCDWORD( r->called_by, STATUS ) &= ~STATUS_WAITING_MASK;
+        }
+
+        r->called_by = NULL;
+
+        /* The process should be destroyed immediately, it is a function-type one */
+        /* Run ONEXIT */
+        if (( LOCDWORD( r, STATUS ) & ~STATUS_WAITING_MASK ) != STATUS_DEAD && r->exitcode ) {
+            LOCDWORD( r, STATUS ) = STATUS_DEAD;
+            r->codeptr = r->code + r->exitcode;
+            ptr = r->codeptr;
+            goto main_loop_instance_go;
+//            instance_go( r );
+//            if ( !instance_exists( r ) ) r = NULL;
+        } else {
+            instance_destroy( r );
+            r = NULL;
+        }
+    }
+
+    /* Hook */
+    if ( r && instance_pos_execute_hook_count ) {
+        for ( n = 0; n < instance_pos_execute_hook_count; n++ )
+            instance_pos_execute_hook_list[n]( r );
+    }
+    /* Hook */
+
+    if ( r && LOCDWORD( r, STATUS ) != STATUS_KILLED && r->first_run ) r->first_run = 0;
+
+    return return_value;
+}
