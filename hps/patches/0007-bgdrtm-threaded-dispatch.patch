+/* Direct-threaded dispatch: every opcode ends with its own indirect jump
+   through op_table instead of looping back to one shared switch jump, so
+   the branch predictor gets one entry per opcode (Cortex-A9, 2026-10-03).
+   THREADED_DISPATCH=0 builds the plain switch from the same source. */
+#ifndef THREADED_DISPATCH
+#if LIBRETRO_CORE && defined( __GNUC__ )
+#define THREADED_DISPATCH 1
+#else
+#define THREADED_DISPATCH 0
+#endif
+#endif
+
+#if THREADED_DISPATCH
+/* The slow paths are table entries picked with selects, not branches, so
+   that each dispatch is one straight block ending in the indirect jump:
+   LLVM merges the 359 copies into one and only tail-duplicates it back
+   into every opcode when it is a single block (plus -tail-dup-pred-size
+   and -tail-dup-succ-size raised past their default 16, see
+   hps/CMakeLists.txt). */
+#define OP_SLOW_CONTINUE 0x1000  /* check set: back to the loop head */
+#define OP_SLOW_NEXT     0x1001  /* stack check, then the loop head */
+#define OP_UNKNOWN       0x1002  /* out of range: default */
+#define OP_TABLE_SIZE    0x1003
+#define OPLABEL(name)   name:
+#define DISPATCH_IF(slow, slow_op) do { \
+            unsigned op_ = (unsigned)*ptr; \
+            op_ = op_ < OP_SLOW_CONTINUE ? op_ : OP_UNKNOWN; \
+            op_ = ( slow ) ? ( slow_op ) : op_; \
+            goto *op_table[op_]; \
+        } while ( 0 )
+#define DISPATCH()      DISPATCH_IF( 0, 0 )
+/* end of an opcode that skipped the stack check (the old `continue`) */
+#define CONTINUE        DISPATCH_IF( check, OP_SLOW_CONTINUE )
+/* end of an opcode (the old `break`): stack check, then straight to the next one */
+#define NEXT            DISPATCH_IF( check | ( sp < stack_base ), OP_SLOW_NEXT )
+#else
+#define OPLABEL(name)
+#define CONTINUE        continue
+#define NEXT            break
+#endif
