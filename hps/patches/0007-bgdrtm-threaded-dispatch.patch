+                ptr++;
+                NEXT;
+
+            case MN_WORD | MN_VARAND: OPLABEL(op_WORD_VARAND)
+            case MN_WORD | MN_VARAND | MN_UNSIGNED: OPLABEL(op_WORD_VARAND_UNSIGNED)
+                *( int16_t * )ptr_from_int( sp[-2] ) &= sp[-1];
