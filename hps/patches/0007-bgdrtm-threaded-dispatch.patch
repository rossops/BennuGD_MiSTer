-static int stack_dump( INSTANCE * r ) {
-    register int * ptr = &r->stack[1];
-    register int i = 0;
-
-    while ( ptr < r->stack_ptr ) {
-        if ( i == 5 ) {
-            i = 0;
-            printf( "\n" );
-        }
-        printf( "%08X ", *ptr++ );
-        i++;
-    }
-
-    return i;
-}
